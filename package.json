{
  "name": "kraft",
  "productName": "Kraft",
  "version": "0.5.0",
  "description": "Terminal-first AI-powered developer IDE",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "pack": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "release": "node scripts/release.mjs",
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "build": {
    "appId": "com.kraft.app",
    "productName": "Kraft",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "identity": "Kraft Dev Signing"
    },
    "publish": {
      "provider": "generic",
      "url": "https://gitlab.example.com/api/v4/projects/0/packages/generic/kraft/latest"
    },
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.24.0",
    "highlight.js": "^11.10.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
